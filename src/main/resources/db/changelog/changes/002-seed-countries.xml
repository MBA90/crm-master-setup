<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- db/changelog/data/countries.csv header: id,name,iso2,iso3,phone_code -->
    <changeSet id="002-seed-countries" author="crm">
        <loadData
                tableName="countries"
                file="db/changelog/data/countries.csv"
                relativeToChangelogFile="false"
                encoding="UTF-8"
                separator=","
                quotchar="&quot;">
            <column name="id" type="NUMERIC"/>
            <column name="name" type="STRING"/>
            <column name="iso2" type="STRING"/>
            <column name="iso3" type="STRING"/>
            <column name="phone_code" type="STRING"/>
        </loadData>
    </changeSet>

</databaseChangeLog>
