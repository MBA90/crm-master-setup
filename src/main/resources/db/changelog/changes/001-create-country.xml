<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-countries" author="crm">
        <createTable tableName="countries">
            <column name="id" type="INT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="iso2" type="CHAR(2)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_countries_iso2"/>
            </column>
            <column name="iso3" type="CHAR(3)">
                <constraints unique="true" uniqueConstraintName="uq_countries_iso3"/>
            </column>
            <column name="phone_code" type="VARCHAR(10)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
